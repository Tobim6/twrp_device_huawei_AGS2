+use std::ffi::CStr;
 use std::sync::Mutex;
 
+/// The kernel's binder driver on this device has no BINDER_FLAG_TXN_SECURITY_CTX, so the calling SID is never available. In recovery
+/// every client of this keystore2 is recovery itself, so fall back to its context.
+fn calling_sid_or_recovery(calling_sid: Option<&CStr>) -> &CStr {
+    calling_sid.unwrap_or_else(|| CStr::from_bytes_with_nul(b"u:r:recovery:s0\0").unwrap())
+}
