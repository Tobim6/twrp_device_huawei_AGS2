+	/* A ROM that still uses Keystore 1 (Android 9 and older) keeps its keys as files in /data/misc/keystore/user_N. keystore2 imports those lazily
+	 * from its own working directory, but only as keys of the *calling* uid, and the locksettings key (created by system_server, uid 1000) is
+	 * looked up by TWRP as root. Work on a copy so the ROM's files are never touched (the import deletes the legacy file), and also
+	 * provide the uid 1000 entries under uid 0. */
+	static void copyLegacyKeystore() {
+		const std::string src_dir = "/data/misc/keystore/user_0";
+		const std::string dst_dir = "/tmp/misc/keystore/user_0";
+		DIR* dir = opendir(src_dir.c_str());
+		if (!dir) {
+			printf("no legacy keystore at '%s': %s\n", src_dir.c_str(), strerror(errno));
+			return;
+		}
+		mkdir(dst_dir.c_str(), 0700);
+		struct dirent* de;
+		while ((de = readdir(dir)) != nullptr) {
+			std::string name = de->d_name;
+			if (name == "." || name == "..") continue;
+			std::string data;
+			if (!android::base::ReadFileToString(src_dir + "/" + name, &data)) continue;
+			android::base::WriteStringToFile(data, dst_dir + "/" + name, 0600, 0, 0);
+			std::string root_name;
+			if (name.compare(0, 5, "1000_") == 0) root_name = "0_" + name.substr(5);
+			else if (name.compare(0, 6, ".1000_") == 0) root_name = ".0_" + name.substr(6);
+			if (!root_name.empty())
+				android::base::WriteStringToFile(data, dst_dir + "/" + root_name, 0600, 0, 0);
+		}
+		closedir(dir);
+		printf("copied legacy keystore from '%s'\n", src_dir.c_str());
+	}
+
