import /init.recovery.hi6250.usb.rc

# This kernel only has the configfs USB gadget; the usb rc is gated on these (the working prague TWRP set them in prop.default)
on early-init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller hisi-usb-otg
    # recovery's vold/keystore code reports errors only through liblog
    start logd

# recovery.fstab and the by-name links use /dev/block/bootdevice
on init
    symlink /dev/block/platform/hi_mci.0 /dev/block/bootdevice
    # This device's device-tree fstab (/proc/device-tree/firmware/android/fstab) lists every partition as "/by-name/<x>" (the
    # platform prefix is normally added by first-stage mount, which recovery skips). libfs_mgr is read first by init and by
    # recovery's bootloader_message code, so without this /misc cannot be opened: the BCB is never cleared (the Huawei bootloader
    # then keeps booting recovery) and init cannot write bootonce-bootloader.
    symlink /dev/block/bootdevice/by-name /by-name

# Boot diagnostics into /cache/twrp_log (see system/bin/twrp_cache_log.sh)
on init
    write /dev/kmsg "twrp: init reached"
    # fscrypt v1 (this 4.4 kernel has no FS_IOC_ADD_ENCRYPTION_KEY): vold needs the "fscrypt" keyring in the session keyring
    install_keyring
    # The keymaster HAL talks to the TEE (hardware keymaster, same as the ROM): libteec connects to teecd / system_teecd and
    # they authenticate the caller by uid, so the HAL runs as system and the daemons have to be up before it opens its TEE context.
    chown system system /dev/tc_ns_client
    chmod 0660 /dev/tc_ns_client
    start system_teecd
    start teecd
    exec_start twrp_rom_props
    start twrp_cache_log

on init
    start twrp_input_rescan

service twrp_input_rescan /system/bin/sh /system/bin/twrp_input_rescan.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

service twrp_rom_props /system/bin/sh /system/bin/twrp_rom_props.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

service twrp_cache_log /system/bin/sh /system/bin/twrp_cache_log.sh
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

# Started from the stock recovery_vendor rc (`start keymaster-3-0` / `start teecd`), which does not define them. Kept running for /data
# decryption (libs they need are in system/lib64, see twrp_AGS2.mk).
service teecd /vendor/bin/teecd
    user root
    group root
    disabled
    seclabel u:r:tee:s0

# TEE keymaster: the EMUI8 keystore.hi6250.so module (from the ROM's vendor, same files) is used instead of the software keymaster, so keys that the
# ROM created in the TEE can be unwrapped here. It links Android 9 libxcollie/libhwlog, which need libbase/liblog symbols that this Android 12 based
# recovery does not have: libags2_compat.so (compat/ags2_compat.c) provides them. Runs as system like in the ROM (the TEE daemons check the uid).
service keymaster-3-0 /vendor/bin/hw/android.hardware.keymaster@3.0-service
    class early_hal
    user system
    group system
    setenv LD_PRELOAD /system/lib64/libags2_compat.so
    disabled
    seclabel u:r:hal_keymaster_default:s0

# Gatekeeper HAL (TEE-backed), needed to verify the user's pattern/PIN for FBE decryption. Same binaries as the ROM's vendor partition.
# libteec talks to two daemons (@tc_ns_socket = teecd, @tc_ns_socket_system = system_teecd) and the daemons authenticate the calling CA by
# uid, so this must run as system exactly like the ROM's rc does (as root teecd just closes the connection).
service system_teecd /system/bin/system_teecd
    socket tui_daemon stream 660 root system
    socket tee-multi-user stream 660 root system
    class early_hal
    user root
    group root readproc
    seclabel u:r:tee:s0
    disabled

service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    class early_hal
    user system
    group system
    seclabel u:r:hal_gatekeeper_default:s0
    disabled

on boot
    chown system system /dev/tc_ns_client
    chmod 0660 /dev/tc_ns_client
    start system_teecd
    start gatekeeper-1-0
