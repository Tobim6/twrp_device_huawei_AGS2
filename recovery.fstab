# Android-style fstab for libfs_mgr (init/recovery libraries). TWRP itself reads the full table from /etc/twrp.fstab.
/dev/block/bootdevice/by-name/cache	/cache	ext4	defaults	defaults
/dev/block/bootdevice/by-name/cust	/cust	ext4	defaults	defaults
/dev/block/bootdevice/by-name/userdata	/data	f2fs	nosuid,nodev,noatime	wait,fileencryption=aes-256-xts:aes-256-cts
/dev/block/bootdevice/by-name/odm	/odm	ext4	defaults	defaults
/dev/block/bootdevice/by-name/kernel	/kernel	emmc	defaults	defaults
/dev/block/bootdevice/by-name/ramdisk	/ramdisk	emmc	defaults	defaults
/dev/block/bootdevice/by-name/system	/system	ext4	defaults	defaults
/dev/block/bootdevice/by-name/vendor	/vendor	ext4	defaults	defaults
/dev/block/bootdevice/by-name/version	/version	ext4	defaults	defaults
/dev/block/bootdevice/by-name/erecovery_ramdisk	/erecovery_ramdisk	emmc	defaults	defaults
/dev/block/bootdevice/by-name/erecovery_kernel	/erecovery_kernel	emmc	defaults	defaults
/dev/block/bootdevice/by-name/erecovery_vbmeta	/erecovery_vbmeta	emmc	defaults	defaults
/dev/block/bootdevice/by-name/erecovery_vendor	/erecovery_vendor	emmc	defaults	defaults
/dev/block/bootdevice/by-name/recovery_vbmeta	/recovery_vbmeta	emmc	defaults	defaults
/dev/block/bootdevice/by-name/recovery_vendor	/recovery_vendor	emmc	defaults	defaults
/dev/block/bootdevice/by-name/recovery_ramdisk	/recovery_ramdisk	emmc	defaults	defaults
/dev/block/bootdevice/by-name/fastboot	/fastboot	emmc	defaults	defaults
/dev/block/bootdevice/by-name/xloader	/xloader	emmc	defaults	defaults
/dev/block/bootdevice/by-name/frp	/frp	emmc	defaults	defaults
/dev/block/bootdevice/by-name/misc	/misc	emmc	defaults	defaults
/dev/block/bootdevice/by-name/nvme	/nvme	emmc	defaults	defaults
/dev/block/bootdevice/by-name/oeminfo	/oeminfo	emmc	defaults	defaults
/dev/block/bootdevice/by-name/splash2	/splash2	ext4	defaults	defaults
/dev/block/bootdevice/by-name/vbmeta	/vbmeta	emmc	defaults	defaults
/dev/block/bootdevice/by-name/modem_fw	/modem_fw	emmc	defaults	defaults
/dev/block/bootdevice/by-name/modem_om	/modem_om	emmc	defaults	defaults
/dev/block/bootdevice/by-name/modemnvm_backup	/modemnvm_backup	emmc	defaults	defaults
/dev/block/bootdevice/by-name/modemnvm_factory	/modemnvm_factory	emmc	defaults	defaults
/dev/block/bootdevice/by-name/modemnvm_img	/modemnvm_img	emmc	defaults	defaults
/dev/block/bootdevice/by-name/modemnvm_system	/modemnvm_system	emmc	defaults	defaults
/dev/block/bootdevice/by-name/modemnvm_update	/modemnvm_update	emmc	defaults	defaults
/dev/block/mmcblk1p1	/external_sd	vfat	defaults	defaults
/dev/block/sda1	/usbotg	auto	defaults	defaults
